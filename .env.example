# ---------------------------------------------------------------------
# API keys / identity
# ---------------------------------------------------------------------
# Obtain from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

ENTREZ_EMAIL=your_email@example.com
# Obtain from: https://www.semanticscholar.org/product/api
S2_API_KEY=your_api_key_here

# ---------------------------------------------------------------------
# vLLM configuration
# ---------------------------------------------------------------------
VLLM_URL="http://127.0.0.1:8000/v1"
VLLM_MODEL="Qwen/Qwen2.5-32B-Instruct"

VLLM_FREQ_PENALTY=0.3
VLLM_PRES_PENALTY=0.1
VLLM_TOP_P=0.9
VLLM_MAX_NEW_TOKENS=512

# ---------------------------------------------------------------------
# HDOCKlite docking backend
# ---------------------------------------------------------------------
VLAB_DOCKING_BACKEND="hdock"
VLAB_REQUIRE_DOCKING=1

HDOCK_HOME=
HDOCK_BIN=
CREATEPL_BIN=

HDOCK_TIMEOUT=420
HDOCK_N_MODELS=5
CREATEPL_TIMEOUT=120

HDOCK_DEBUG_DIR=
PROTEIN_CACHE_DIR=
RNA_HDOCK_CACHE_DIR=
RNA_PREP_DEBUG_DIR=

# ---------------------------------------------------------------------
# Docking convergence / target filtering
# ---------------------------------------------------------------------
VLAB_AGENT_EVAL_TOP_N=2
VLAB_MAX_DOCKINGS_PER_TARGET=2
VLAB_ABORT_TARGET_ON_FIRST_TIMEOUT=1

VLAB_MIN_VALID_HDOCK_SCORE=-30
VLAB_MIN_VALID_DOCKINGS_PER_TARGET=2
VLAB_MIN_VALID_DOCKINGS_FOR_CONVERGENCE=2

VLAB_REJECT_TARGET_ON_SCORE_SPREAD=1
VLAB_MAX_TARGET_SCORE_SPREAD=25

VLAB_ACCEPT_BINDING_SCORE=-50
VLAB_MAX_ACCEPT_SCORE_SPREAD=15.0
VLAB_CONVERGENCE_SPREAD_THRESHOLD=5.0

VLAB_MAX_RECEPTOR_ATOMS=60000

VLAB_TARGET_BLACKLIST="5TC1,8PNF"
VLAB_TARGET_RESET_ON_HIGH_SPREAD=1
VLAB_TARGET_RESET_REQUIRE_WEAK_BINDING=1
VLAB_TARGET_MARK_RESET_AS_FAILED=1
VLAB_TARGET_RESET_MIN_VALID_N=2
VLAB_TARGET_RESET_EXTREME_SPREAD_MULTIPLIER=2.0

# Strict scientific convergence controls
VLAB_ALLOW_CONVERGENCE_ON_REVISE=0
VLAB_REQUIRE_CONSERVATION_FOR_CONVERGENCE=1
VLAB_MIN_CONSERVATION_FOR_ACCEPT=0.2

# ---------------------------------------------------------------------
# RNA fold quality thresholds
# ---------------------------------------------------------------------
VLAB_RNA_ENFORCE_MIN_FOLD=1

VLAB_RNA_MIN_ACCEPT_PAIR_DENSITY=0.24
VLAB_RNA_MIN_ACCEPT_MFE_PER_NT=-0.08

VLAB_RNA_TARGET_PAIR_DENSITY=0.35
VLAB_RNA_TARGET_MFE_PER_NT=-0.15

VLAB_RNA_FOLD_THRESHOLD_PENALTY=2.5

# ---------------------------------------------------------------------
# RNAalifold / conservation-aware gating
# ---------------------------------------------------------------------
VLAB_ALIFOLD_MIN_CONSERVATION_FITNESS=0.5
VLAB_ALIFOLD_ADVISORY_WHEN_LOW_CONSERVATION=1

# ---------------------------------------------------------------------
# RNA sequence validation / deduplication
# ---------------------------------------------------------------------
VLAB_RNA_DEDUP_NEAR_DUPLICATES=1
VLAB_RNA_NEAR_DUP_MAX_HAMMING=2
VLAB_RNA_MAX_HOMOPOLYMER=4

# ---------------------------------------------------------------------
# Bioinfo / conservation
# ---------------------------------------------------------------------
VLAB_BIOINFO_FETCH_LIMIT=20
VLAB_BIOINFO_MAX_MSA_IDENTITY=0.995

# ---------------------------------------------------------------------
# Motif selection objective
# ---------------------------------------------------------------------
VLAB_RNA_TARGET_MOTIFS="GAG:0.55,AAG:0.55,CAG:0.35,GUC:0.35,AGU:0.35,CUG:0.25,UAC:0.20,RGAG:0.30,RAAG:0.30"
VLAB_RNA_REQUIRE_TARGET_MOTIF=0

# ---------------------------------------------------------------------
# Literature deduplication / streaming
# ---------------------------------------------------------------------
VLAB_LIT_DEDUP_ABSTRACT_PREFIX_LEN=500
VLAB_STREAM_WARMUP_SECONDS=6.0

# ---------------------------------------------------------------------
# NSGA-II optimisation
# ---------------------------------------------------------------------
VLAB_RNA_SEQ_LEN=60
VLAB_NSGA_POP_SIZE=40
VLAB_NSGA_GENERATIONS=8
VLAB_NSGA_HDOCK_TOP_K=5

# ---------------------------------------------------------------------
# Dynamic RCSB target selection
# ---------------------------------------------------------------------
VLAB_TARGET_SELECTION_MODE="rcsb_dynamic"
VLAB_TARGET_MAX_CANDIDATES=8
VLAB_TARGET_MIN_YEAR=2015
VLAB_TARGET_MAX_RESOLUTION=4.0
VLAB_TARGET_REQUIRE_EXPERIMENTAL=1

VLAB_TARGET_ALLOW_CRYOEM=1
VLAB_TARGET_ALLOW_XRAY=1
VLAB_TARGET_ALLOW_NMR=0

VLAB_TARGET_KEYWORDS="capsid,coat protein,viral assembly,RNA binding,RNA packaging,stem-loop"
VLAB_FALLBACK_PDBS="2HW8,5V6I,6N4W,7K9U,7K9V"

PDB_DOWNLOAD_TIMEOUT=60
VLAB_ALLOW_MMCIF_RECEPTORS=1

# ---------------------------------------------------------------------
# Docking visual snapshots
# ---------------------------------------------------------------------
VLAB_RENDER_DOCKING_SNAPSHOTS=1
VLAB_DOCKING_SNAPSHOT_DIR=
VLAB_RENDER_TIMEOUT=180

# ---------------------------------------------------------------------
# Protein-RNA interface contact scoring
# ---------------------------------------------------------------------
VLAB_ANALYSE_INTERFACE_CONTACTS=1
VLAB_INTERFACE_CONTACT_DIR=
VLAB_INTERFACE_CONTACT_CUTOFF=5.0
VLAB_MIN_INTERFACE_RESIDUE_CONTACTS=5
VLAB_MIN_INTERFACE_BASIC_CONTACTS=1